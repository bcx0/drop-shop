<section class="ff-tiktok ff-reveal" style="
  background: #111111;
  padding: 80px 20px;
  border-top: 1px solid #222222;
">
  <div style="max-width: 1000px; margin: 0 auto;">

    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: #7C3AED;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      text-align: center;
      margin-bottom: 16px;
    ">— LA COMMUNAUTÉ —</p>

    <h2 style="
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.8rem, 5vw, 3rem);
      font-weight: 800;
      color: #F8F8F8;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 16px;
    ">LA COMMUNAUTÉ PORTE FUTUR FLARE</h2>

    <p style="
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      color: #9CA3AF;
      text-align: center;
      margin-bottom: 48px;
    ">Ils ont osé. À ton tour.</p>

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 48px;
    ">

      <div style="
        background: #1a1a1a;
        border: 1px solid #222222;
        border-radius: 4px;
        aspect-ratio: 9/16;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
      ">
        <p style="
          font-family: 'Space Mono', monospace;
          font-size: 11px;
          color: #4B5563;
          text-align: center;
          padding: 20px;
        ">AJOUTE TON<br>TIKTOK ICI<br><br>Embed via<br>TikTok oEmbed</p>
      </div>

      <div style="
        background: #1a1a1a;
        border: 1px solid #222222;
        border-radius: 4px;
        aspect-ratio: 9/16;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      ">
        <p style="
          font-family: 'Space Mono', monospace;
          font-size: 11px;
          color: #4B5563;
          text-align: center;
          padding: 20px;
        ">AJOUTE TON<br>TIKTOK ICI<br><br>Embed via<br>TikTok oEmbed</p>
      </div>

      <div style="
        background: #1a1a1a;
        border: 1px solid #222222;
        border-radius: 4px;
        aspect-ratio: 9/16;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      ">
        <p style="
          font-family: 'Space Mono', monospace;
          font-size: 11px;
          color: #4B5563;
          text-align: center;
          padding: 20px;
        ">AJOUTE TON<br>TIKTOK ICI<br><br>Embed via<br>TikTok oEmbed</p>
      </div>

    </div>

    <div style="text-align: center;">
      <a href="https://www.tiktok.com/@futurflare" target="_blank" style="
        font-family: 'Space Grotesk', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #7C3AED;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border: 1px solid #7C3AED;
        padding: 14px 32px;
        border-radius: 2px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s ease;
      ">NOUS SUIVRE SUR TIKTOK</a>
    </div>

  </div>
</section>

