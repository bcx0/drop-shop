<section class="ff-fomo ff-reveal" style="
  background: #111111;
  border-top: 1px solid #222222;
  border-bottom: 1px solid #222222;
  padding: 48px 20px;
">
  <div style="max-width: 900px; margin: 0 auto;">

    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: #7C3AED;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      text-align: center;
      margin-bottom: 40px;
    ">— DROP EN COURS —</p>

    <div class="ff-fomo__stats" style="
      display: flex;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    ">
      <div style="text-align: center;">
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; font-weight: 800; color: #F8F8F8; margin: 0;">1 247</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 13px; color: #9CA3AF; margin: 8px 0 0 0; text-transform: uppercase; letter-spacing: 0.1em;">Commandes expédiées</p>
      </div>
      <div style="text-align: center;">
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; font-weight: 800; color: #F8F8F8; margin: 0;">4.8 ⭐</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 13px; color: #9CA3AF; margin: 8px 0 0 0; text-transform: uppercase; letter-spacing: 0.1em;">Note moyenne</p>
      </div>
      <div style="text-align: center;">
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; font-weight: 800; color: #EF4444; margin: 0;">FAIBLE</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 13px; color: #9CA3AF; margin: 8px 0 0 0; text-transform: uppercase; letter-spacing: 0.1em;">Stock restant</p>
      </div>
    </div>

    <div style="
      background: #1a1a1a;
      border: 1px solid #7C3AED;
      border-radius: 4px;
      padding: 20px 32px;
      text-align: center;
      max-width: 600px;
      margin: 0 auto;
    " class="ff-glow-pulse">
      <p style="
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        color: #F8F8F8;
        margin: 0;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      ">⚡ Chaque pièce est produite en quantité limitée. Pas de restocks.</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FF FOMO Bar",
  "settings": [],
  "presets": [
    {
      "name": "FF FOMO Bar"
    }
  ]
}
{% endschema %}
