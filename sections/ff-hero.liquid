<section id="ff-hero" style="
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #080808;
  overflow: hidden;
">

  {% if section.settings.background_image %}
  <div style="
    position: absolute;
    inset: 0;
    z-index: 0;
  ">
    {{ section.settings.background_image | image_url: width: 1920 | image_tag:
      loading: 'eager',
      style: 'width:100%;height:100%;object-fit:cover;opacity:0.4;'
    }}
    <div style="
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(8,8,8,0.3) 0%,
        rgba(8,8,8,0.5) 50%,
        rgba(8,8,8,0.95) 100%
      );
    "></div>
  </div>
  {% endif %}

  <div class="ff-hero__content ff-reveal" style="
    text-align: center;
    z-index: 2;
    position: relative;
    padding: 0 20px;
    max-width: 900px;
    margin: 0 auto;
  ">
    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: #7C3AED;
      text-transform: uppercase;
      letter-spacing: 0.4em;
      margin-bottom: 32px;
      display: block;
    ">— NOUVELLE COLLECTION —</p>

    <h1 class="ff-glitch" data-text="{{ section.settings.headline }}" style="
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(3rem, 10vw, 7rem);
      font-weight: 800;
      color: #F8F8F8;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      line-height: 1;
      margin-bottom: 24px;
    ">{{ section.settings.headline }}</h1>

    <p style="
      font-family: 'Inter', sans-serif;
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      color: #9CA3AF;
      max-width: 500px;
      margin: 0 auto 48px auto;
      line-height: 1.6;
    ">{{ section.settings.subtitle }}</p>

    <div style="
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    ">
      <a href="{{ section.settings.cta_primary_link }}" style="
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 800;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: white;
        background: linear-gradient(135deg, #7C3AED, #06B6D4);
        padding: 18px 40px;
        border-radius: 2px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 0 20px rgba(124,58,237,0.4);
      ">{{ section.settings.cta_primary_text }}</a>

      <a href="{{ section.settings.cta_secondary_link }}" style="
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #7C3AED;
        background: transparent;
        border: 1px solid #7C3AED;
        padding: 18px 40px;
        border-radius: 2px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
      ">{{ section.settings.cta_secondary_text }}</a>
    </div>
  </div>

  <div style="
    position: absolute;
    bottom: 32px;
    left: 32px;
    background: rgba(17,17,17,0.95);
    border: 1px solid #7C3AED;
    border-radius: 4px;
    padding: 12px 20px;
    z-index: 10;
    backdrop-filter: blur(10px);
  " class="ff-glow-pulse">
    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 12px;
      color: #F8F8F8;
      margin: 0;
    ">🔥 <span id="ff-watchers">23 personnes regardent ce drop</span></p>
  </div>

  <div style="
    position: absolute;
    bottom: 32px;
    right: 32px;
    z-index: 10;
  ">
    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: #4B5563;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      writing-mode: vertical-rl;
    ">SCROLL</p>
  </div>

</section>

{% schema %}
{
  "name": "FF Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (dark recommandée)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titre principal",
      "default": "PORTE CE QUE TU SERAS."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Streetwear Y2K. Éditions limitées. Pour ceux qui construisent leur futur."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Texte bouton principal",
      "default": "VOIR LE DROP"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Lien bouton principal"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Texte bouton secondaire",
      "default": "LES TENUES"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Lien bouton secondaire"
    }
  ],
  "presets": [
    {
      "name": "FF Hero"
    }
  ]
}
{% endschema %}
