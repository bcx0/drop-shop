<section id="ff-hero" style="
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #080808;
  overflow: hidden;
">

  <!-- Ambient glow background -->
  <div style="
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(124,58,237,0.12) 0%, rgba(6,182,212,0.05) 40%, transparent 70%);
    pointer-events: none;
    animation: ambientPulse 4s ease-in-out infinite;
  "></div>

  <!-- 3D Rotating Logo -->
  <div class="ff-logo-3d-wrapper" style="
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    height: 380px;
    perspective: 800px;
    z-index: 1;
  ">
    <div class="ff-logo-3d" style="
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      animation: rotateLogo 12s linear infinite;
    ">
      <!-- Front face -->
      <div class="ff-logo-face ff-logo-front" style="
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid rgba(124,58,237,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 40% 40%, rgba(124,58,237,0.08), transparent 60%);
        box-shadow:
          0 0 40px rgba(124,58,237,0.2),
          inset 0 0 40px rgba(124,58,237,0.05);
        backface-visibility: hidden;
      ">
        <div style="text-align: center;">
          <p style="
            font-family: 'Space Grotesk', sans-serif;
            font-size: 72px;
            font-weight: 800;
            color: #F8F8F8;
            letter-spacing: -0.02em;
            line-height: 1;
            margin: 0;
            text-shadow:
              0 0 20px rgba(124,58,237,0.8),
              0 0 40px rgba(124,58,237,0.4),
              0 0 80px rgba(6,182,212,0.2);
          ">FF</p>
          <p style="
            font-family: 'Space Mono', monospace;
            font-size: 9px;
            color: #7C3AED;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            margin: 8px 0 0 0;
          ">FUTUR FLARE</p>
        </div>
      </div>

      <!-- Orbit ring 1 -->
      <div style="
        position: absolute;
        inset: -20px;
        border-radius: 50%;
        border: 1px solid rgba(124,58,237,0.25);
        animation: orbitRing1 8s linear infinite;
      "></div>

      <!-- Orbit ring 2 -->
      <div style="
        position: absolute;
        inset: -45px;
        border-radius: 50%;
        border: 1px solid rgba(6,182,212,0.15);
        animation: orbitRing2 14s linear infinite reverse;
      ">
        <!-- Orbit dot -->
        <div style="
          position: absolute;
          top: -4px;
          left: 50%;
          transform: translateX(-50%);
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: #06B6D4;
          box-shadow: 0 0 10px #06B6D4, 0 0 20px rgba(6,182,212,0.5);
        "></div>
      </div>

      <!-- Orbit ring 3 -->
      <div style="
        position: absolute;
        inset: -70px;
        border-radius: 50%;
        border: 1px solid rgba(168,85,247,0.1);
        animation: orbitRing3 20s linear infinite;
      ">
        <!-- Orbit dot 2 -->
        <div style="
          position: absolute;
          bottom: -4px;
          left: 50%;
          transform: translateX(-50%);
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: #7C3AED;
          box-shadow: 0 0 8px #7C3AED, 0 0 16px rgba(124,58,237,0.5);
        "></div>
      </div>
    </div>
  </div>

  <!-- Hero content -->
  <div class="ff-hero__content ff-reveal" style="
    text-align: center;
    z-index: 2;
    position: relative;
    padding: 0 20px;
    max-width: 900px;
    margin: 0 auto;
    margin-top: 420px;
  ">
    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: #7C3AED;
      text-transform: uppercase;
      letter-spacing: 0.5em;
      margin-bottom: 20px;
      display: block;
    ">— NOUVELLE COLLECTION —</p>

    <h1 style="
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2.5rem, 8vw, 6rem);
      font-weight: 800;
      color: #F8F8F8;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      line-height: 1;
      margin-bottom: 20px;
      text-shadow: 0 0 30px rgba(124,58,237,0.3);
    ">{{ section.settings.headline }}</h1>

    <p style="
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      color: #6B7280;
      max-width: 460px;
      margin: 0 auto 40px auto;
      line-height: 1.7;
    ">{{ section.settings.subtitle }}</p>

    <div style="
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    ">
      <a href="{{ section.settings.cta_primary_link }}" style="
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: white;
        background: linear-gradient(135deg, #7C3AED, #06B6D4);
        padding: 16px 40px;
        border-radius: 2px;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 0 20px rgba(124,58,237,0.4);
        transition: all 0.3s ease;
      ">{{ section.settings.cta_primary_text }}</a>

      <a href="{{ section.settings.cta_secondary_link }}" style="
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #7C3AED;
        background: transparent;
        border: 1px solid #7C3AED;
        padding: 16px 40px;
        border-radius: 2px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
      ">{{ section.settings.cta_secondary_text }}</a>
    </div>
  </div>

  <!-- FOMO badge -->
  <div style="
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(17,17,17,0.9);
    border: 1px solid rgba(124,58,237,0.5);
    border-radius: 100px;
    padding: 10px 24px;
    z-index: 10;
    backdrop-filter: blur(10px);
    white-space: nowrap;
  " class="ff-glow-pulse">
    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: #F8F8F8;
      margin: 0;
      letter-spacing: 0.05em;
    ">🔥 <span id="ff-watchers">23 personnes regardent ce drop</span></p>
  </div>

</section>

<style>
  @keyframes rotateLogo {
    0% { transform: rotateY(0deg) rotateX(5deg); }
    100% { transform: rotateY(360deg) rotateX(5deg); }
  }

  @keyframes orbitRing1 {
    0% { transform: rotateZ(0deg) rotateX(70deg); }
    100% { transform: rotateZ(360deg) rotateX(70deg); }
  }

  @keyframes orbitRing2 {
    0% { transform: rotateZ(0deg) rotateX(60deg) rotateY(30deg); }
    100% { transform: rotateZ(360deg) rotateX(60deg) rotateY(30deg); }
  }

  @keyframes orbitRing3 {
    0% { transform: rotateZ(0deg) rotateX(80deg) rotateY(45deg); }
    100% { transform: rotateZ(360deg) rotateX(80deg) rotateY(45deg); }
  }

  @keyframes ambientPulse {
    0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  }

  #ff-hero {
    min-height: 100vh;
  }

  @media (max-width: 768px) {
    .ff-logo-3d-wrapper {
      width: 260px !important;
      height: 260px !important;
    }
    .ff-hero__content {
      margin-top: 300px !important;
    }
  }

  .ff-logo-3d:hover {
    animation-play-state: paused;
  }
</style>

{% schema %}
{
  "name": "FF Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Titre principal",
      "default": "PORTE CE QUE TU SERAS."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Streetwear Y2K. Éditions limitées. Pour ceux qui construisent leur futur."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Texte bouton principal",
      "default": "VOIR LE DROP"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Lien bouton principal"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Texte bouton secondaire",
      "default": "LES TENUES"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Lien bouton secondaire"
    }
  ],
  "presets": [
    {
      "name": "FF Hero"
    }
  ]
}
{% endschema %}
