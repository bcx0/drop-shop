<style>
.ff-bar-track {
  display: flex;
  gap: 80px;
  white-space: nowrap;
  width: max-content;
  animation: ffBar 80s linear infinite;
}
.ff-bar-track span {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  color: #F8F8F8;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  padding: 0 20px;
}
@keyframes ffBar {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.ff-bar-wrap:hover .ff-bar-track {
  animation-play-state: paused;
}
</style>

<div class="ff-bar-wrap" style="
  background: #080808;
  border-bottom: 1px solid #7C3AED;
  overflow: hidden;
  padding: 10px 0;
">
