<div class="ff-announcement-bar" style="
  background: #080808;
  border-bottom: 1px solid #7C3AED;
  overflow: hidden;
  padding: 10px 0;
  position: relative;
  z-index: 100;
">
  <div id="ff-announcement-track" style="
    display: flex;
    gap: 60px;
    white-space: nowrap;
    animation: ffScroll 25s linear infinite;
  ">
    <span>⚡ DROP LIMITÉ — STOCKS CRITIQUES</span>
    <span>📦 Expédition sous 48h — Suivi en temps réel</span>
    <span>🔄 Retours gratuits sous 30 jours</span>
    <span>🔒 Paiement 100% sécurisé</span>
    <span>🔥 +1200 commandes expédiées</span>
    <span>⚡ DROP LIMITÉ — STOCKS CRITIQUES</span>
    <span>📦 Expédition sous 48h — Suivi en temps réel</span>
    <span>🔄 Retours gratuits sous 30 jours</span>
    <span>🔒 Paiement 100% sécurisé</span>
    <span>🔥 +1200 commandes expédiées</span>
  </div>
</div>

<style>
  .ff-announcement-bar span {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: #F8F8F8;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  @keyframes ffScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .ff-announcement-bar:hover #ff-announcement-track {
    animation-play-state: paused;
  }
</style>

