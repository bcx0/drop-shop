<section class="ff-why ff-reveal" style="
  background: #080808;
  padding: 80px 20px;
">
  <div style="max-width: 900px; margin: 0 auto;">

    <p style="
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: #7C3AED;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      text-align: center;
      margin-bottom: 16px;
    ">— L'IDENTITÉ —</p>

    <h2 style="
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.8rem, 5vw, 3rem);
      font-weight: 800;
      color: #F8F8F8;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 64px;
    ">CE QU'ON EST.<br>CE QU'ON N'EST PAS.</h2>

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    ">

      <div style="
        background: #111111;
        border: 1px solid #222222;
        border-radius: 4px;
        padding: 32px;
        transition: border-color 0.3s ease;
      " onmouseover="this.style.borderColor='#7C3AED'" onmouseout="this.style.borderColor='#222222'">
        <p style="font-size: 1.5rem; margin-bottom: 16px;">⚡</p>
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: #F8F8F8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Sélection exigeante</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #9CA3AF; line-height: 1.6; margin: 0;">Pièces choisies pour leur esthétique, pas leur volume. On ne vend pas tout.</p>
      </div>

      <div style="
        background: #111111;
        border: 1px solid #222222;
        border-radius: 4px;
        padding: 32px;
        transition: border-color 0.3s ease;
      " onmouseover="this.style.borderColor='#7C3AED'" onmouseout="this.style.borderColor='#222222'">
        <p style="font-size: 1.5rem; margin-bottom: 16px;">🔒</p>
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: #F8F8F8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Stock contrôlé</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #9CA3AF; line-height: 1.6; margin: 0;">Pas de surproduction. Quand c'est parti, c'est parti. C'est voulu.</p>
      </div>

      <div style="
        background: #111111;
        border: 1px solid #222222;
        border-radius: 4px;
        padding: 32px;
        transition: border-color 0.3s ease;
      " onmouseover="this.style.borderColor='#7C3AED'" onmouseout="this.style.borderColor='#222222'">
        <p style="font-size: 1.5rem; margin-bottom: 16px;">📦</p>
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: #F8F8F8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Expédié sous 48h</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #9CA3AF; line-height: 1.6; margin: 0;">Suivi en temps réel. Livraison rapide, emballage soigné.</p>
      </div>

      <div style="
        background: #111111;
        border: 1px solid #222222;
        border-radius: 4px;
        padding: 32px;
        transition: border-color 0.3s ease;
      " onmouseover="this.style.borderColor='#7C3AED'" onmouseout="this.style.borderColor='#222222'">
        <p style="font-size: 1.5rem; margin-bottom: 16px;">💳</p>
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: #F8F8F8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Paiement sécurisé</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #9CA3AF; line-height: 1.6; margin: 0;">Retours sans prise de tête sous 30 jours. Zéro risque.</p>
      </div>

      <div style="
        background: #111111;
        border: 1px solid #222222;
        border-radius: 4px;
        padding: 32px;
        transition: border-color 0.3s ease;
      " onmouseover="this.style.borderColor='#7C3AED'" onmouseout="this.style.borderColor='#222222'">
        <p style="font-size: 1.5rem; margin-bottom: 16px;">🎯</p>
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: #F8F8F8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Pour ceux qui refusent le mainstream</p>
        <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #9CA3AF; line-height: 1.6; margin: 0;">Futur Flare c'est un état d'esprit. Pas juste des fringues.</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "FF Why Section",
  "settings": [],
  "presets": [
    {
      "name": "FF Why Section"
    }
  ]
}
{% endschema %}
